# Please do not directly edit this file. Instead, modify the .env variables related to NGINX configuration.

server {
    listen ${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};
    # Re-resolve Docker service names when upstream containers restart (avoids stale IP / 502).
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /console/api {
      set $dify_api_backend api:5001;
      proxy_pass http://$dify_api_backend;
      include proxy.conf;
    }

    location /api {
      set $dify_api_backend api:5001;
      proxy_pass http://$dify_api_backend;
      include proxy.conf;
    }

    location /socket.io/ {
      resolver 127.0.0.11 valid=30s ipv6=off;
      set $socket_io_upstream ${NGINX_SOCKET_IO_UPSTREAM};
      proxy_pass http://$socket_io_upstream;
      include proxy.conf;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_cache_bypass $http_upgrade;
    }

    location /v1 {
      set $dify_api_backend api:5001;
      proxy_pass http://$dify_api_backend;
      include proxy.conf;
    }

    location /openapi {
      set $dify_api_backend api:5001;
      proxy_pass http://$dify_api_backend;
      include proxy.conf;
    }

    location /files {
      set $dify_api_backend api:5001;
      proxy_pass http://$dify_api_backend;
      include proxy.conf;
    }

    location /explore {
      proxy_pass http://web:3000;
      include proxy.conf;
    }

    location /e/ {
      proxy_pass http://plugin_daemon:5002;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include proxy.conf;
    }

    location / {
      proxy_pass http://web:3000;
      include proxy.conf;
    }

    location /mcp {
      set $dify_api_backend api:5001;
      proxy_pass http://$dify_api_backend;
      include proxy.conf;
    }

    location /triggers {
      set $dify_api_backend api:5001;
      proxy_pass http://$dify_api_backend;
      include proxy.conf;
    }
    
    # placeholder for acme challenge location
    ${ACME_CHALLENGE_LOCATION}

    # placeholder for https config defined in https.conf.template
    ${HTTPS_CONFIG}
}
